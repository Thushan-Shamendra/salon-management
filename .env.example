# MongoDB Atlas Connection
MONGODB_URI=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial Admin Bootstrap Credentials (Used only by npm run seed:admin)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_INITIAL_PASSWORD=

# Cloudinary Image Management (Signed Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Places API Key (Server-Side Only - Display-Only Google Reviews)
GOOGLE_PLACES_API_KEY=

# SMTP Email Configuration (Server-Side Only - Admin Password Reset OTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI Assistant Configuration (Server-Side Only - Group 5)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Integration Settings Encryption Key (Server-Side Only - AES-256-GCM)
# Used only to encrypt database-stored integration overrides.
# Keep this secret server-side and never expose it to the client.
INTEGRATION_ENCRYPTION_KEY=

